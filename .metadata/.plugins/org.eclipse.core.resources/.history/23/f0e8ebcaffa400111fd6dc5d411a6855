package core;

public class P010_Multidimensional {
	public static void main(String[] args) {
		int arr[][] = { { 1, 2, 3 }, { 4, 5, 6 }, { 7, 8, 9 } };
		System.out.println(arr[1][2]);

		for (int r = 0; r <= 2; r++) {
			for (int c = 0; c <arr[r].length; c++) {
				System.out.print(arr[r][c] + " ");
			}
			System.out.println();
		}
	}
}
