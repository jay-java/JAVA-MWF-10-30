package core;

//1.runtime(overriding)
//2.compile-time(overloading)

class Overloading {
	public void add(int a, int b) {
		System.out.println(a + b);
	}

	public int add(int a, int b, int c) {
		System.out.println(a + b + c);
		return a + b + c;
	}

	public void add(double a, int b, int c) {
		System.out.println(a + b + c);
	}
}

class Parent {
	public void data1() {
		System.out.println("data method in parent");
	}
}

class Child extends Parent {
	public void data() {
		System.out.println("data method in child");
	}
}

public class P015_Polymorphism {
	public static void main(String[] args) {
		Overloading o = new Overloading();
		o.add(12, 34, 46);

		Child c = new Child();
		c.data();
		c.data1();
	}
}
