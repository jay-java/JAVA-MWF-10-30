package core;

class Student {
	int id;
	String name;
	double per;
	long contact;

	Student(int id, String name, double per, long contact) {
		this.id = id;
		this.name = name;
		this.per = per;
		this.contact = contact;
	}

	@Override
	public String toString() {
		return "id : "+id+" name "+name+" per : "+per+ " contact : "+contact;
	}
}

