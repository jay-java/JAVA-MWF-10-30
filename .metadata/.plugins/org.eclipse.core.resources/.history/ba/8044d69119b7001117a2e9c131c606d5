package core;

import java.io.FileOutputStream;

class Laptop {
	int ram;
	String model;
	double price;

	public Laptop() {

	}

	public Laptop(int ram, String model, double price) {
		this.ram = ram;
		this.model = model;
		this.price = price;
	}
	
	@Override
	public String toString() {
		return "ram : "+ram+" model : "+model+" price : "+price;
	}
}

public class P024_Serialization {
	public static void main(String[] args) {
		Laptop l1 = new Laptop(12, "dell", 78940.21);
		
		FileOutputStream fos = new FileOutputStream("laptop.txt");
		
	}
}
