package core;

import java.util.ArrayList;
import java.util.List;

class Student {
	int id;
	String name;
	double per;
	long contact;

	Student(int id, String name, double per, long contact) {
		this.id = id;
		this.name = name;
		this.per = per;
		this.contact = contact;
	}

	@Override
	public String toString() {
		return "id : " + id + " name " + name + " per : " + per + " contact : " + contact;
	}
}

public class P026_ListPractical {
	public static void main(String[] args) {
		Student s1 = new Student(1, "Morin", 75.30, 896746350);
		Student s2 = new Student(2, "Maulik", 75.30, 896746350);
		Student s3 = new Student(3, "Keval", 75.30, 896746350);
		Student s4 = new Student(4, "Dishant", 75.30, 896746350);

		List<Student> list = new ArrayList<Student>();
		list.add(s1);
		list.add(s2);
		list.add(s3);
		list.add(s4);
	}
}
