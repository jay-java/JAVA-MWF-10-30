package core;

class Laptop {
	int ram;
	String model;
	double price;

	public Laptop() {

	}

	public Laptop(int ram, String model, double price) {
		this.ram = ram;
		this.model = model;
		this.price = price;
	}
	
	@Override
	public String toString() {
		return "ram : "+ram+" model : "+model+" price : "+price;
	}
}

