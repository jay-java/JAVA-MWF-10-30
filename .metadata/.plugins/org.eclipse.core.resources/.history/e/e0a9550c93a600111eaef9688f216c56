package core;

class User {
	User() {
		System.out.println("user default constructor");
	}

	User(int i) {
		System.out.println("parameter : " + i);
	}

	User(int i, int j) {
		System.out.println("parameter : " + i + " j = " + j);
	}

	// copy constructor-> object cloning

	public void call() {
		System.out.println("call in user");
	}
}

public class P013_Constructor {
	public static void main(String[] args) {
		User u = new User();
		u.call();

		User u1 = new User(123, 345);
	}
}
