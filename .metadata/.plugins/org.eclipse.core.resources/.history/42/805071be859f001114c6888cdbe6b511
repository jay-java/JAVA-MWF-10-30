package core;

public class P008_Patterns {
	public static void main(String[] args) {
		for (int i = 1; i <= 3; i++) { // row
			for (int j = 1; j <= 3; j++) { // col
				System.out.print("*");
			}
			System.out.println();
		}

		for (int i = 1; i <= 3; i++) { // row
			for (int j = 1; j <= i; j++) { // col
				System.out.print("*");
			}
			System.out.println();
		}

		for (int i = 1; i <= 5; i++) { // row
			for (int j = 1; j <= i; j++) { // col
				System.out.print(j);
			}
			System.out.println();
		}

		for (int i = 1; i <= 5; i++) { // row
			for (int j = 1; j <= i; j++) { // col
				System.out.print(i);
			}
			System.out.println();
		}

		for (int i = 1; i <= 5; i++) {
			for(int s = 4; s>=1;s--) {
				System.out.print(" ");
			}
			for (int j = 1; j <= i; j++) {
				System.out.print("*");
			}
			System.out.println();
		}

	}
}
