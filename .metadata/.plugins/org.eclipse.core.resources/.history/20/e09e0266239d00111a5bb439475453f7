package core;

public class P004_TypeCasting {
	public static void main(String[] args) {
		byte b = 1; // 1
		int i = b; // 4 -> implicit
		short s = (short) i; // 2 -> explicit

		int q= 1;
		double d = q;
		System.out.println(d);
		
		int a = 10;
		int b1 = 3;
		double c = (double)a / (double)b1;
		System.out.doubleprintln(c);
	}
}
