class A {
	A() {
		System.out.println("A class def cons");
	}

	public void classA() {
		System.out.println("class A method");
	}
}

class B extends A {
	public void classB() {
		System.out.println("class B method");
	}
}

class C extends B {
	public void classC() {
		System.out.println("class C method");
	}
}



public class P014_Inheritance {
	public static void main(String[] args) {
		B b = new B();
		b.classA();
		b.classB();
	}
}
