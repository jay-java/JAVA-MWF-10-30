package core;

public class P003_Operators {
	public static void main(String[] args) {
		// 1.Arithmetic -> +,-,*,/,%
		int a = 10;
		int b = 20;
		System.out.println(a + b);
		System.out.println(a - b);
		System.out.println(a * b);
		System.out.println(a / b);
		System.out.println(a % b);

		// 2.Assignment -> =,+=,-=,*=,/=
		int i = 10;

		i += 12; // i = i+12
		System.out.println(i); // 22

		i -= 10;
		System.out.println(i);

		i *= 2; // i = i *2
		System.out.println(i);

		i /= 2;
		System.out.println(i);

		int j = 14;

		j += i;// j = j+i
		System.out.println(j);
		
		
		//3.Comparison -> >,<,>=,<=,==,!=
		System.out.println(10 > 2);
		System.out.println(10 >= 10);
		System.out.println(10 < 2);
		System.out.println(10 <= 10);
		System.out.println(10 == 10);
		System.out.println(10 != 2);
		
