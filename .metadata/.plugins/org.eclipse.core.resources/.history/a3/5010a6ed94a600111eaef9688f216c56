package core;

class User {
	int id;
	String name;
	long contact;

	User() {
		System.out.println("user default constructor");
	}

	User(int i) {
		System.out.println("parameter : " + i);
	}

	User(int i, int j) {
		System.out.println("parameter : " + i + " j = " + j);
	}

	User(int id, String name, long contact) {
		this.id = id;
		this.name = name;
		this.contact = contact;
		System.out.println("id = " + id + " name = " + name + " contact = " + contact);
	}
	
	

	public void showData() {
		System.out.println("id = " + id + " name = " + name + " contact = " + contact);
	}

	// copy constructor-> object cloning

	public void call() {
		System.out.println("call in user");
	}
}

public class P013_Constructor {
	public static void main(String[] args) {
		User u = new User();
		u.call();

		User u1 = new User(123, 345);

		User u2 = new User(1, "java", 987654321l);
		u2.showData();

		User u3 = new User();
	}
}
