package core;


//By Thread

class Thread1 extends Thread{
	public void run() {
		for (int i = 1; i <= 5; i++) {
			System.out.println("Thread class"+i + " : " + Thread.currentThread());
			try {
				Thread.sleep(3000);
			} catch (InterruptedException e) {
				// TODO Auto-generated catch block
				e.printStackTrace();
			}
		}
	}
}

