class A {
	public void classA() {
		System.out.println("class A method");
	}
}

class B extends A {
	public void classB() {
		System.out.println("class B method");
	}
}

public class P014_Inheritance {
	public static void main(String[] args) {
		B b = new B();
		b.classA();
		b.classB();
	}
}
